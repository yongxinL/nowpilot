{
  "name": "nowpilot",
  "description": "AI-native Chrome Side Panel + Standalone view assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:ai": "vitest run tests/core/ai --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:isolation": "vitest run tests/isolation",
    "verify:phase-1": "eslint . && prettier --check . && tsc --noEmit && wxt build && vitest run",
    "verify:phase-2": "eslint . && prettier --check . && tsc --noEmit && wxt build && vitest run",
    "verify:phase-3": "eslint . && prettier --check . && tsc --noEmit && wxt build && vitest run",
    "verify:phase-3a": "eslint . && prettier --check . && tsc --noEmit && wxt build && vitest run",
    "verify:phase-4": "eslint . && prettier --check . && tsc --noEmit && wxt build && vitest run",
    "verify:phase-4a": "eslint . && prettier --check . && tsc --noEmit && wxt build && vitest run",
    "verify:e2e-phase-1": "node tests/e2e/load-smoke.mjs",
    "verify:all": "tsc --noEmit && vitest run && pnpm run lint"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1.2.12",
    "@ai-sdk/google": "1.2.22",
    "@ai-sdk/openai": "1.3.24",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@mozilla/readability": "^0.5.0",
    "ai": "4.3.19",
    "antd": "^6.5.3",
    "defuddle": "^0.19.2",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "immer": "^10.2.0",
    "minisearch": "^7.2.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@puppeteer/browsers": "^3.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wxt": "^0.19.29"
  }
}
