{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // strict:true per D-21 (REQ-R19, spec §7.8). Phase 1 sweep resolves
    // every trivial cast to a real type; genuinely-structural residue is
    // suppressed with sequential // @ts-expect-error NP-STRICT-<n>:
    // markers (Phase 2-3 reduce this ceiling to 0 per D-21/STACK §35).
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "node", "vite/client"],
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "entrypoints/**/*",
    "tests/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output",
    "references"
  ]
}

